{
    "name": "faisal/wirasat-calculator",
    "description": "Islamic inheritance (Faraid) calculator and guide library: a tested PHP rule engine, a plain-PHP site around it, and a web installer.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Faraid\\": "src/Faraid/",
            "App\\": "src/App/"
        },
        "files": [
            "src/App/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Faraid\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php bin/run-tests.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
